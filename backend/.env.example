# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (local dev: run `mongod` locally, or use MongoDB Atlas connection string in production)
MONGO_URI=mongodb://127.0.0.1:27017/equilibrium

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Google OAuth (create credentials at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (for verification / password reset — e.g. SendGrid, Mailgun, or Gmail SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@equilibrium.app

# AI microservice
AI_SERVICE_URL=http://localhost:8000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
